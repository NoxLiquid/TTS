# Движок: Silero v5_cis_base_nostress (MIT), 29 русских голосов ru_* + SSML-prosody (pitch/rate)
TTS_API_TOKEN=change-me-to-a-long-random-secret
TTS_HOST_PORT=5000
# дефолтный спикер — фолбэк для неизвестного имени; в игре голос назначается по voices.yml
TTS_DEFAULT_SPEAKER=ru_eduard
TTS_SAMPLE_RATE=24000
TTS_WORKERS=3
TTS_TORCH_THREADS=2
TTS_MAX_QUEUE=48
TTS_CACHE_SIZE=512
TTS_LOG_LEVEL=info
TTS_CPU_LIMIT=6
TTS_MEM_LIMIT=4g
